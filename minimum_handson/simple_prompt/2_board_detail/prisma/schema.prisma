generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Board {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  lists     List[]
}

model List {
  id      String @id @default(cuid())
  title   String
  order   Int
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}
