// Simple Kanban のデータモデル
// 参照: design/001_minimum_kanban.md データモデル / spec/01_board.md, 02_list.md, 03_card.md

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// FR-101 / FR-103 ボード
model Board {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())

  lists List[]
}

// FR-201 / FR-203 リスト（Board に属し、boardId 内で order 昇順・重複なし）
model List {
  id        String   @id @default(cuid())
  title     String
  order     Int
  boardId   String
  createdAt DateTime @default(now())

  board Board  @relation(fields: [boardId], references: [id])
  cards Card[]

  @@unique([boardId, order])
}

// FR-301 / FR-303 カード（List に属し、listId 内で order 昇順・重複なし）
model Card {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  listId      String
  createdAt   DateTime @default(now())

  list List @relation(fields: [listId], references: [id])

  @@unique([listId, order])
}
