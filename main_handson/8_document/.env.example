DATABASE_URL="file:./dev.db"

# アプリの絶対 URL (招待 URL の base として使う。 dev では http://localhost:3000)
APP_BASE_URL="http://localhost:3000"

# 既存 CardComments が「自分のコメント」 判定に使う fallback ID。
# 本 spec 011 の Cookie ベース認証導入後は認可 (削除許可) はサーバー側で行われるため、
# 本値が誤っても API レベルでは 403/404 に fallback する。 seed の default user 用に残す。
NEXT_PUBLIC_DEFAULT_USER_ID="user_default"
