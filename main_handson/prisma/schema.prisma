// design/001_boards.md / 002_lists.md / 003_cards.md § データモデル
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum LabelColor {
  gray
  red
  orange
  yellow
  green
  blue
  purple
  pink
}

// design/013_permissions.md § データモデル
enum BoardRole {
  owner
  member
  viewer
}

// design/012_member_invite.md § データモデル
enum InviteStatus {
  pending
  accepted
  revoked
}

// design/011_auth.md § データモデル
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  memberships BoardMembership[]
  invitesSent Invite[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BoardMembership {
  id        String    @id @default(cuid())
  boardId   String
  userId    String
  role      BoardRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
}

model Invite {
  id              String       @id @default(cuid())
  boardId         String
  email           String
  role            BoardRole
  token           String       @unique
  status          InviteStatus @default(pending)
  expiresAt       DateTime
  invitedByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy User  @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([email])
}

model Board {
  id        String   @id @default(cuid())
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists       List[]
  labels      Label[]
  memberships BoardMembership[]
  invites     Invite[]
}

model List {
  id        String   @id @default(cuid())
  boardId   String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId])
}

model Card {
  id          String    @id @default(cuid())
  listId      String
  title       String
  description String    @default("")
  order       Int
  dueDate     DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  list       List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  cardLabels CardLabel[]

  @@index([listId])
}

model Label {
  id        String     @id @default(cuid())
  boardId   String
  name      String
  color     LabelColor
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  board      Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cardLabels CardLabel[]

  @@index([boardId])
}

model CardLabel {
  id      String @id @default(cuid())
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([cardId, labelId])
  @@index([cardId])
  @@index([labelId])
}
